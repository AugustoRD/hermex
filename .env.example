# PostgreSQL (Docker Compose)
POSTGRES_USER=hermex
POSTGRES_PASSWORD=hermex_secret
POSTGRES_DB=hermex_dev
POSTGRES_PORT=5432

# Prisma & Backend (apps/api)
DATABASE_URL="postgresql://hermex:hermex_secret@localhost:5432/hermex_dev?schema=public"
PORT=3001
JWT_SECRET="hermex-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001/graphql"
AUTH_SECRET="hermex-auth-secret-dev"
